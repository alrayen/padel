                  name="AlwaysUseDefaultCodePage">false</property>
                <property
                  dataType="System.Int32"
                  description="Specifies the mode used to access the database."
                  name="AccessMode"
                  typeConverter="AccessMode">2</property>
                <property
                  dataType="System.String"
                  description="The mappings between the parameters in the SQL command and variables."
                  name="ParameterMapping"></property>
              </properties>
              <connections>
                <connection
                  refId="Package\dim product\sa.Connections[OleDbConnection]"
                  connectionManagerID="{7FA582B1-0FD4-4EF7-9D79-40E1000778BA}:external"
                  connectionManagerRefId="Project.ConnectionManagers[sa]"
                  description="The OLE DB runtime connection used to access the database."
                  name="OleDbConnection" />
              </connections>
              <outputs>
                <output
                  refId="Package\dim product\sa.Outputs[OLE DB Source Output]"
                  name="OLE DB Source Output">
                  <outputColumns>
                    <outputColumn
                      refId="Package\dim product\sa.Outputs[OLE DB Source Output].Columns[product_code]"
                      dataType="wstr" length="50"
                      errorOrTruncationOperation="Conversion"
