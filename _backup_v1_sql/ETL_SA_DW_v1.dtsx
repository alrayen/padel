    <DTS:Executable
      DTS:refId="Package\dim date"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{AE365EE2-A12B-4341-BC3E-85794EEA0DF1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="dim date"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F059DCD0-AA63-44DA-B592-F369A4E589C2}"
          SQLTask:SqlStatementSource="WITH n AS (&#xA;    SELECT TOP (DATEDIFF(day, &#x27;20210101&#x27;, &#x27;20261231&#x27;) + 1)&#xA;           ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) - 1 AS i&#xA;    FROM sys.all_objects a CROSS JOIN sys.all_objects b&#xA;), d AS (SELECT DATEADD(day, i, CAST(&#x27;20210101&#x27; AS date)) AS dt FROM n)&#xA;INSERT INTO dbo.DIM_DATE (date_key, full_date, [day], [week], [month], [quarter], [year])&#xA;SELECT CONVERT(int, CONVERT(char(8), dt, 112)), dt, DAY(dt), DATEPART(iso_week, dt),&#xA;       MONTH(dt), DATEPART(quarter, dt), YEAR(dt)&#xA;FROM d&#xA;WHERE NOT EXISTS (SELECT 1 FROM dbo.DIM_DATE x WHERE x.full_date = d.dt);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
